# SNMP Agent — Kconfig options.
# See snmp.h for the public API and quick-start guide.
# Referenced RFCs: 3412, 3414, 3415, 3416, 3418, 1213.

menu "SNMP Agent Configuration"

config SNMP_AGENT
	bool "Enable SNMP Agent Subsystem"
	depends on NETWORKING
	depends on NET_UDP
	depends on NET_SOCKETS
	select NET_SOCKETS_SERVICE
	default n
	help
	  Master switch for the embedded SNMP agent (v1/v2c/v3).
	  Enables the ASN.1 BER codec, MIB tree engine, and UDP :161 listener.
	  Disable to remove all SNMP code from the binary (~0 bytes).

if SNMP_AGENT

config SNMP_AGENT_PORT
	int "SNMP Agent UDP listening port"
	default 161
	range 1 65535
	help
	  UDP port on which the SNMP agent listens for incoming queries (default: 161).

config SNMP_COMMUNITY_READ
	string "Default read community string (SNMPv1/v2c)"
	default "public"
	depends on SNMP_VERSION_1 || SNMP_VERSION_2C
	help
	  Community string required for GET, GETNEXT, and GETBULK requests.

config SNMP_COMMUNITY_WRITE
	string "Default write community string (SNMPv1/v2c)"
	default "private"
	depends on SNMP_VERSION_1 || SNMP_VERSION_2C
	help
	  Community string required for SET requests.

config SNMP_VERSION_1
	bool "Enable SNMPv1 protocol support"
	default y
	help
	  SNMPv1 (RFC 1157) — community-based authentication.
	  Supports GET, GETNEXT, SET, and TRAP-v1.
	  Traps use the legacy v1 format (enterprise OID + agent-addr fields).
	  For modern NMS compatibility, prefer v2c traps (VERSION_2C).

config SNMP_VERSION_2C
	bool "Enable SNMPv2c protocol support"
	default y
	help
	  SNMPv2c (RFC 3416) — community-based authentication.
	  Supports GET, GETNEXT, GETBULK, SET, TRAP-v2c, and INFORM.
	  Bulk operations (snmpbulkwalk) require this option.
	  Traps use the standard v2c format with sysUpTime.0 + snmpTrapOID.0
	  varbinds. This is the recommended version for modern NMS tools.

config SNMP_VERSION_3
	bool "Enable SNMPv3 protocol support"
	default n
	select PSA_CRYPTO
	select MBEDTLS
	select PSA_WANT_KEY_TYPE_AES
	help
	  SNMPv3 (RFC 3412/3414/3415) — User-based Security Model (USM)
	  with HMAC-SHA1 authentication and AES-128-CFB privacy.
	  Requires PSA Crypto / mbedtls. Adds ~8 KB FLASH, ~3 KB RAM.
	  Supports engine discovery (Report-PDU), timeliness check (150 s
	  window), and View-based Access Control (VACM) with admin/readonly
	  groups. Key localization per RFC 3414 §A.2.


if SNMP_VERSION_3

config SNMP_V3_ENGINE_BOOTS
	int "SNMPv3 engine boots counter"
	default 1
	range 1 2147483647
	help
	  Initial value for the SNMPv3 authoritative engine boots counter
	  (snmpEngineBoots). Must be strictly monotonically increasing
	  across reboots to prevent replay attacks (RFC 3414 §5.1.3).
	  Persist this value in EEPROM / backup SRAM and read it at boot
	  via prj.conf or a runtime setter.

config SNMP_V3_USER_NAME
	string "SNMPv3 user name"
	default "admin"
	help
	  Security name (msgUserName) for the default SNMPv3 user.
	  This name is matched against the incoming message's user field
	  in the USM security parameters.

config SNMP_V3_AUTH_PASS
	string "SNMPv3 authentication password"
	default "authpass123"
	help
	  Authentication password for HMAC-SHA1 or HMAC-MD5.
	  Used to derive the localized auth key (RFC 3414 §A.2).
	  Change this from the default before deploying.

config SNMP_V3_PRIV_PASS
	string "SNMPv3 privacy password"
	default "privpass123"
	help
	  Privacy (encryption) password for AES-128-CFB or DES-CBC.
	  Used to derive the localized priv key (RFC 3414 §A.2).
	  Change this from the default before deploying.

config SNMP_USM_AUTH_SHA
	bool "Enable HMAC-SHA-1 authentication"
	default y
	select PSA_WANT_ALG_SHA_1
	help
	  Enable SHA-1 based HMAC authentication for SNMPv3 (RFC 3414).
	  Produces a 12-byte authentication tag. Recommended over MD5.

config SNMP_USM_AUTH_MD5
	bool "Enable HMAC-MD5 authentication (Insecure)"
	default n
	select PSA_WANT_ALG_MD5
	help
	  Enable MD5 based HMAC authentication for SNMPv3 (RFC 3414).
	  Produces a 12-byte authentication tag. MD5 is considered
	  cryptographically broken; use SHA-1 or disable v3 instead.

config SNMP_USM_PRIV_AES
	bool "Enable AES-128 privacy encryption"
	default y
	help
	  Enable AES-128 in CFB mode for SNMPv3 scopedPDU encryption
	  (RFC 3414). Uses a 16-byte initialization vector.

config SNMP_USM_PRIV_DES
	bool "Enable DES privacy encryption"
	default n
	help
	  Enable DES in CBC mode for SNMPv3 scopedPDU encryption
	  (RFC 3414). DES is deprecated and should only be used for
	  legacy NMS compatibility.

endif # SNMP_VERSION_3


config SNMP_MAX_PDU_SIZE
	int "Maximum SNMP PDU size in bytes"
	default 1024
	help
	  Maximum size of a single SNMP packet (request or response).
	  Larger GetBulk responses are truncated. Most SNMP implementations
	  use 1500-2048; 1024 is conservative for embedded use.

config SNMP_MAX_OID_LEN
	int "Maximum OID depth"
	default 16
	help
	  Maximum number of sub-identifiers in an OID. A typical enterprise
	  OID like .1.3.6.1.4.1.54321.1.2.3.0 has depth 11.
	  Higher values increase struct size and stack usage.

config SNMP_MAX_VARBINDS
	int "Maximum Varbinds per PDU"
	default 32
	help
	  Maximum number of variable bindings in a single request/response.
	  GetBulk responses use this as a hard limit on the total number
	  of varbinds returned. Higher values increase static BSS memory.

config SNMP_MAX_MIB_NODES
	int "Maximum registered MIB nodes"
	default 128
	help
	  Maximum number of MIB nodes that can be registered in the tree.
	  The default MIB-II groups consume 37 nodes (30 snmp counters +
	  7 system group). The remaining slots are available for enterprise
	  MIB nodes.

config SNMP_MAX_TABLES
	int "Maximum registered MIB tables"
	default 8
	help
	  Maximum number of MIB tables that can be registered. Each table
	  supports single-integer indexing with per-column get/set callbacks.

config SNMP_TRAP_ENABLED
	bool "Enable SNMP Trap & Inform notification engine"
	default y
	help
	  Enable generation and transmission of SNMP Traps v1/v2c/v3
	  and Inform requests (acknowledged notifications) to configured
	  trap destinations on UDP port 162.
	  When both v2c and v1 are enabled, traps use the v2c format.

if SNMP_TRAP_ENABLED

config SNMP_TRAP_PORT
	int "SNMP Trap destination UDP port"
	default 162
	range 1 65535
	help
	  Destination UDP port for SNMP traps and notifications (default: 162).

choice SNMP_TRAP_FORMAT
	prompt "Trap notification format"
	default SNMP_TRAP_FORMAT_V2C if SNMP_VERSION_2C
	default SNMP_TRAP_FORMAT_V1 if SNMP_VERSION_1
	default SNMP_TRAP_FORMAT_V3 if SNMP_VERSION_3
	help
	  Format used when generating SNMP traps and notifications.

config SNMP_TRAP_FORMAT_V1
	bool "SNMPv1 Trap (RFC 1157)"
	depends on SNMP_VERSION_1
	help
	  Generate legacy TRAPv1 PDU with enterprise OID and agent address.

config SNMP_TRAP_FORMAT_V2C
	bool "SNMPv2c Trap (RFC 3416)"
	depends on SNMP_VERSION_2C
	help
	  Generate SNMPv2-Trap PDU with sysUpTime.0 and snmpTrapOID.0 varbinds.

config SNMP_TRAP_FORMAT_V3
	bool "SNMPv3 Notification (RFC 3412)"
	depends on SNMP_VERSION_3
	help
	  Generate SNMPv3 notification PDU with USM security.

endchoice

config SNMP_TRAP_DEST_COUNT
	int "Maximum concurrent trap destinations"
	default 3
	help
	  Maximum number of trap destination hosts.
	  Destinations are configured at runtime via
	  snmp_trap_add_destination(). Increase this if you need
	  to send traps to more than 3 NMS servers.

endif # SNMP_TRAP_ENABLED

config SNMP_RATE_LIMIT
	bool "Enable SNMP request rate limiting"
	default n
	help
	  Enable a simple token-bucket rate limiter for incoming SNMP
	  requests. When the rate limit is exceeded, requests are silently
	  dropped and snmpSilentDrops counter is incremented. This helps
	  protect against CPU exhaustion from SNMP floods.

if SNMP_RATE_LIMIT

config SNMP_RATE_LIMIT_RPS
	int "Maximum requests per second"
	default 20
	range 1 1000
	help
	  Maximum number of SNMP requests processed per second.
	  Requests beyond this limit are silently dropped.
	  A value of 20 is reasonable for most embedded devices.

config SNMP_RATE_LIMIT_BURST
	int "Burst allowance"
	default 5
	range 0 50
	help
	  Number of extra requests allowed in a burst beyond the
	  steady-state rate. Higher values allow short bursts but
	  increase vulnerability to CPU spikes.

endif # SNMP_RATE_LIMIT

module = SNMP
module-str = snmp
source "subsys/logging/Kconfig.template.log_config"

endif # SNMP_AGENT

endmenu
